@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Set stdromano_DIR (or CMAKE_PREFIX_PATH) to the stdromano install chronos was built against
find_dependency(stdromano CONFIG)

# The exported targets carry the per-configuration locations (import libraries, debug postfix...)
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

set_and_check(chronos_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

if(WIN32)
    set_and_check(chronos_BIN_DIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
endif()

set(chronos_LIBRARIES @PROJECT_NAME@::@PROJECT_NAME@)

check_required_components(chronos)
